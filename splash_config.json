    {
      "id": "gitix_1789139244651_1",
      "themeName": "زهرة الليل",
      "fileName": "زهرة الليل.gitix",
      "iconClass": "fa-solid fa-flower",
      "allowUploadPhoto": false,
      "allowChangeColors": false,
      "maxColors": 0,
      "fontsChange": false,
      "fontsDraw": false,
      "borderChange": false,
      "bodyHtml": "<!DOCTYPE html>\n<html lang=\"ar\" dir=\"rtl\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n<title>زهرة الليل</title>\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin>\n<link href=\"https://fonts.googleapis.com/css2?family=Aref+Ruqaa:wght@400;700&family=IBM+Plex+Sans+Arabic:wght@300;400;500&display=swap\" rel=\"stylesheet\">\n<style>\n  :root{\n    --night-900:#0B0F1F;\n    --night-700:#1B2340;\n    --moon-100:#EDEAE3;\n    --bloom-300:#C9A9E0;\n    --leaf-500:#7A9A7C;\n    --warm-200:#E8D9B5;\n  }\n\n  *{ box-sizing:border-box; margin:0; padding:0; }\n\n  html,body{\n    height:100%;\n    background: radial-gradient(ellipse 120% 90% at 50% 30%, var(--night-700) 0%, var(--night-900) 65%);\n    overflow:hidden;\n  }\n\n  body{\n    display:flex;\n    align-items:center;\n    justify-content:center;\n    font-family:'IBM Plex Sans Arabic', sans-serif;\n    color:var(--moon-100);\n    position:relative;\n    min-height:100vh;\n  }\n\n  /* ---- star field ---- */\n  .stars{\n    position:absolute;\n    inset:0;\n    overflow:hidden;\n    pointer-events:none;\n  }\n  .star{\n    position:absolute;\n    width:2px;\n    height:2px;\n    border-radius:50%;\n    background:var(--moon-100);\n    opacity:.35;\n  }\n  .star.twinkle{\n    animation: twinkle 4.5s ease-in-out infinite;\n  }\n  @keyframes twinkle{\n    0%,100%{ opacity:.15; }\n    50%{ opacity:.9; }\n  }\n\n  /* ---- stage ---- */\n  .stage{\n    position:relative;\n    z-index:2;\n    display:flex;\n    flex-direction:column;\n    align-items:center;\n    text-align:center;\n    padding: 6vh 8vw;\n    max-width:520px;\n  }\n\n  .bloom-wrap{\n    width:min(46vw, 260px);\n    height:min(46vw, 260px);\n    margin-bottom:2.2rem;\n    position:relative;\n  }\n\n  .moon-glow{\n    filter: blur(6px);\n  }\n\n  .petal{\n    transform-origin:0px 0px;\n    fill:var(--bloom-300);\n    opacity:0;\n    transform:scale(.1);\n    animation: unfurl 1.6s cubic-bezier(.2,.8,.2,1) forwards;\n  }\n  .petal:nth-child(1){ animation-delay:.15s; }\n  .petal:nth-child(2){ animation-delay:.30s; }\n  .petal:nth-child(3){ animation-delay:.45s; }\n  .petal:nth-child(4){ animation-delay:.60s; }\n  .petal:nth-child(5){ animation-delay:.75s; }\n  .petal:nth-child(6){ animation-delay:.90s; }\n\n  @keyframes unfurl{\n    0%{ opacity:0; transform:scale(.08) rotate(var(--r)); }\n    55%{ opacity:1; }\n    100%{ opacity:.92; transform:scale(1) rotate(var(--r)); }\n  }\n\n  .core{\n    opacity:0;\n    animation: coreGlow 1.2s ease-out forwards;\n    animation-delay:1.15s;\n  }\n  @keyframes coreGlow{\n    0%{ opacity:0; transform:scale(.5); }\n    100%{ opacity:1; transform:scale(1); }\n  }\n\n  .wordmark{\n    font-family:'Aref Ruqaa', serif;\n    font-weight:700;\n    font-size:clamp(2.4rem, 7vw, 3.4rem);\n    line-height:1.15;\n    color:var(--moon-100);\n    opacity:0;\n    animation: riseIn .9s ease-out forwards;\n    animation-delay:1.5s;\n  }\n\n  .tagline{\n    margin-top:.9rem;\n    font-size:1rem;\n    font-weight:300;\n    color:#C9C6CE;\n    line-height:1.9;\n    opacity:0;\n    animation: riseIn .9s ease-out forwards;\n    animation-delay:1.75s;\n  }\n\n  @keyframes riseIn{\n    0%{ opacity:0; transform:translateY(10px); }\n    100%{ opacity:1; transform:translateY(0); }\n  }\n\n  .divider{\n    width:1px;\n    height:34px;\n    background:linear-gradient(to bottom, transparent, var(--leaf-500), transparent);\n    margin:1.8rem 0;\n    opacity:0;\n    animation: riseIn .9s ease-out forwards;\n    animation-delay:1.95s;\n  }\n\n  .cta{\n    opacity:0;\n    animation: riseIn .9s ease-out forwards;\n    animation-delay:2.1s;\n  }\n\n  .cta button{\n    font-family:'IBM Plex Sans Arabic', sans-serif;\n    font-size:.95rem;\n    font-weight:500;\n    color:var(--moon-100);\n    background:transparent;\n    border:1px solid rgba(237,234,227,.35);\n    border-radius:2px;\n    padding:.85rem 2.4rem;\n    cursor:pointer;\n    letter-spacing:.02em;\n    transition: background .4s ease, border-color .4s ease, color .4s ease;\n  }\n  .cta button:hover{\n    background:var(--bloom-300);\n    border-color:var(--bloom-300);\n    color:var(--night-900);\n  }\n  .cta button:focus-visible{\n    outline:2px solid var(--warm-200);\n    outline-offset:3px;\n  }\n\n  .footer{\n    position:absolute;\n    bottom:5vh;\n    left:0;\n    right:0;\n    text-align:center;\n    font-size:.78rem;\n    font-weight:300;\n    color:#8A8798;\n    opacity:0;\n    animation: riseIn 1s ease-out forwards;\n    animation-delay:2.4s;\n    z-index:2;\n  }\n  .footer span{\n    color:var(--warm-200);\n  }\n\n  @media (prefers-reduced-motion: reduce){\n    .petal, .core, .wordmark, .tagline, .divider, .cta, .footer, .star.twinkle{\n      animation:none !important;\n      opacity:1 !important;\n      transform:none !important;\n    }\n  }\n</style>\n</head>\n<body>\n\n  <div class=\"stars\" id=\"stars\"></div>\n\n  <main class=\"stage\">\n    <div class=\"bloom-wrap\">\n      <svg viewBox=\"-130 -130 260 260\" width=\"100%\" height=\"100%\" aria-hidden=\"true\">\n        <defs>\n          <radialGradient id=\"moonGrad\" cx=\"50%\" cy=\"50%\" r=\"50%\">\n            <stop offset=\"0%\" stop-color=\"#3A4066\" stop-opacity=\"0.9\"/>\n            <stop offset=\"100%\" stop-color=\"#1B2340\" stop-opacity=\"0\"/>\n          </radialGradient>\n          <radialGradient id=\"coreGrad\" cx=\"50%\" cy=\"50%\" r=\"50%\">\n            <stop offset=\"0%\" stop-color=\"#E8D9B5\"/>\n            <stop offset=\"100%\" stop-color=\"#C9A9E0\"/>\n          </radialGradient>\n        </defs>\n\n        <circle class=\"moon-glow\" cx=\"0\" cy=\"0\" r=\"105\" fill=\"url(#moonGrad)\"/>\n\n        <g>\n          <path class=\"petal\" style=\"--r:0deg\"   transform=\"rotate(0)\"   d=\"M0,-6 C16,-46 10,-92 0,-112 C-10,-92 -16,-46 0,-6 Z\"/>\n          <path class=\"petal\" style=\"--r:60deg\"  transform=\"rotate(60)\"  d=\"M0,-6 C16,-46 10,-92 0,-112 C-10,-92 -16,-46 0,-6 Z\"/>\n          <path class=\"petal\" style=\"--r:120deg\" transform=\"rotate(120)\" d=\"M0,-6 C16,-46 10,-92 0,-112 C-10,-92 -16,-46 0,-6 Z\"/>\n          <path class=\"petal\" style=\"--r:180deg\" transform=\"rotate(180)\" d=\"M0,-6 C16,-46 10,-92 0,-112 C-10,-92 -16,-46 0,-6 Z\"/>\n          <path class=\"petal\" style=\"--r:240deg\" transform=\"rotate(240)\" d=\"M0,-6 C16,-46 10,-92 0,-112 C-10,-92 -16,-46 0,-6 Z\"/>\n          <path class=\"petal\" style=\"--r:300deg\" transform=\"rotate(300)\" d=\"M0,-6 C16,-46 10,-92 0,-112 C-10,-92 -16,-46 0,-6 Z\"/>\n        </g>\n\n        <circle class=\"core\" cx=\"0\" cy=\"0\" r=\"9\" fill=\"url(#coreGrad)\"/>\n      </svg>\n    </div>\n\n    <h1 class=\"wordmark\">زهرة الليل</h1>\n    <p class=\"tagline\">دليل إلى الأزهار التي لا تتفتح إلا بعد أن ينام النهار</p>\n\n    <div class=\"divider\"></div>\n\n    <div class=\"cta\">\n      <button onclick=\"this.blur()\">ابدأ الجولة</button>\n    </div>\n  </main>\n\n  <div class=\"footer\">زهرة الليلة: <span>ياسمين الليل</span></div>\n\n<script>\n  // scatter a modest, restrained star field\n  const starsEl = document.getElementById('stars');\n  const total = 46;\n  for (let i = 0; i < total; i++){\n    const s = document.createElement('div');\n    s.className = 'star';\n    if (i % 12 === 0) s.classList.add('twinkle');\n    s.style.top = Math.random() * 100 + '%';\n    s.style.left = Math.random() * 100 + '%';\n    const scale = 0.6 + Math.random() * 1.4;\n    s.style.width = (2 * scale) + 'px';\n    s.style.height = (2 * scale) + 'px';\n    if (i % 12 === 0) s.style.animationDelay = (Math.random() * 4) + 's';\n    starsEl.appendChild(s);\n  }\n</script>\n\n</body>\n</html>\n"
    }
  ],
